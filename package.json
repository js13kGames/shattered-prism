{
    "name": "shattered-prism",
    "version": "0.0.0",
    "private": true,
    "description": "An arena-survival FPS in a brutalist megastructure, under 13 KB",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/piesku/goodluck.git"
    },
    "contributors": [
        "Sta\u015b Ma\u0142olepszy <stas@piesku.com>",
        "Micha\u0142 Budzy\u0144ski <michal@virtualdesign.pl>"
    ],
    "license": "ISC",
    "scripts": {
        "clean": "find . -type d -name node_modules -prune -o \\( -name '*.js' -o -name '*.js.map' \\) -exec rm {} +",
        "lint": "prettier --check \"**/*.ts\"",
        "pretty": "prettier --write \"**/*.ts\"",
        "start": "esbuild src/index.ts --define:DEBUG=true --target=es2020 --bundle --sourcemap --outdir=. --outbase=. --servedir=. --serve=1234",
        "build": "esbuild src/index.ts --define:DEBUG=true --target=es2020 --bundle --sourcemap --outdir=. --outbase=.",
        "test": "npm run lint && npm run ts:check",
        "ts:check": "tsc --noEmit",
        "ts:watch": "tsc --noEmit --watch -p .",
        "selftest": "esbuild src/selftest.ts --bundle --define:DEBUG=true --platform=node --format=esm --outfile=selftest.mjs && node selftest.mjs"
    },
    "devDependencies": {
        "esbuild": "0.23",
        "prettier": "3.3",
        "typescript": "5.5"
    },
    "engines": {
        "node": ">=18"
    }
}
